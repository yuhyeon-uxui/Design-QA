rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Other collections can have their own rules
    match /issue_events/{eventId} {
      // Only authenticated users can create events
      allow create: if request.auth != null 
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.eventType == "STATUS_CHANGE"
                    && request.resource.data.reason.size() >= 0;
      
      // Events are immutable (cannot be updated or deleted by clients)
      allow update, delete: if false;
      allow read: if request.auth != null;
    }
    
    // Default fallback (you can restrict this further based on your app's needs)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
