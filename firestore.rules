rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /issue_events/{eventId} {
      allow read: if true;
      allow write: if false; // Only allow Server Action (Firebase Admin) to write
    }
    
    // Default fallback for other collections
    // Exclude issue_events explicitly from the catch-all just to be safe
    match /{document=**} {
      allow read, write: if !request.path.segments.hasAny(['issue_events']);
    }
  }
}
